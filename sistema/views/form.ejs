<%- include('cabecalho',{titulo}) %><p><a href="/<%= slug %>">← Voltar</a></p><p class="etiqueta">FORMULÁRIO</p><h1><%= titulo %></h1><% if(erro){ %><p class="alerta erro"><%= erro %></p><% } %><form class="formulario" method="post" action="/<%= slug %><%= registro.id ? '/'+registro.id : '' %>"><% campos.forEach(c=>{ %><label><%= c.rotulo %><% if(c.tipo==='select'){ %><select name="<%= c.chave %>" required><option value="">Selecione...</option><% c.opcoes.forEach(o=>{ %><option value="<%= o.valor %>" <%= String(c.valor)===String(o.valor)?'selected':'' %>><%= o.texto %></option><% }) %></select><% } else { %><input name="<%= c.chave %>" type="<%= c.tipo %>" value="<%= c.valor %>" required><% } %></label><% }) %><button class="botao" type="submit">Salvar</button></form><%- include('rodape') %>
