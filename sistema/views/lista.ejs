<%- include('cabecalho',{titulo}) %><div class="titulo"><div><p class="etiqueta">CADASTROS</p><h1><%= titulo %></h1></div><a class="botao" href="/<%= slug %>/novo">＋ Novo cadastro</a></div>
<% if(slug==='responsaveis'){ %><form class="busca" method="get"><input name="busca" value="<%= busca %>" placeholder="Buscar por nome"><button>Buscar</button></form><% } %>
<div class="tabela"><table><thead><tr><% headers.forEach(h=>{ %><th><%= h %></th><% }) %><th>Ações</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><% r.cells.forEach(c=>{ %><td><%= c %></td><% }) %><td class="acoes"><a href="/<%= slug %>/<%= r.id %>/editar">Editar</a><form method="post" action="/<%= slug %>/<%= r.id %>/excluir" onsubmit="return confirm('Excluir este registro?')"><button>Excluir</button></form></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p class="vazio">Nenhum registro encontrado.</p><% } %></div><%- include('rodape') %>
